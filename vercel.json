{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/quartos-pousada-cachoeira-do-sol.html",
      "destination": "/acomodacoes.html",
      "permanent": true
    },
    {
      "source": "/day-use-pousada-cachoeira-do-sol-jaboticatubas.html",
      "destination": "/day-use.html",
      "permanent": true
    },
    {
      "source": "/cachoeira-do-sol-mg.html",
      "destination": "/cachoeira.html",
      "permanent": true
    },
    {
      "source": "/cardapio-pousada-cachoeira-do-sol.html",
      "destination": "/gastronomia.html",
      "permanent": true
    },
    {
      "source": "/localizacao-pousada-cachoeira-do-sol.html",
      "destination": "/como-chegar.html",
      "permanent": true
    },
    {
      "source": "/normas-pouasada-cachoeira-do-sol.html",
      "destination": "/normas.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}